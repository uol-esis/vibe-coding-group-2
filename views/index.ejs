<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <title><%= title %></title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 24'%3E%3Cg fill='none' stroke='%23d1392b' stroke-width='2.2' stroke-linecap='round'%3E%3Cpath d='M16 3 30.7 13.3M16 3 21.9 20M16 3V21M16 3 10.1 20M16 3 1.3 13.3'/%3E%3Cpath d='M30.7 13.3A18 18 0 0 1 1.3 13.3'/%3E%3C/g%3E%3C/svg%3E">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  <link rel="stylesheet" href="/style.css?v=<%= version %>">
</head>
<body>
  <header class="navbar">
    <a class="brand" href="/" aria-label="StadtApp <%= city.name %> – Startseite">
      <!-- Fächer-Logo: Karlsruhes Straßen laufen fächerförmig vom Schloss aus -->
      <svg viewBox="0 0 32 24" aria-hidden="true">
        <g fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round">
          <path d="M16 3 30.7 13.3M16 3 26.8 17.4M16 3 21.9 20M16 3V21M16 3 10.1 20M16 3 5.2 17.4M16 3 1.3 13.3"/>
          <path d="M30.7 13.3A18 18 0 0 1 1.3 13.3"/>
        </g>
        <circle cx="16" cy="3" r="2.6" fill="var(--accent)"/>
      </svg>
      <span class="brand-name"><%= city.name %></span>
      <span class="brand-sub">StadtApp</span>
    </a>

    <div class="nav-actions">
      <button type="button" id="btn-filter" class="btn" aria-expanded="false" aria-controls="filter-panel"
              aria-label="Filter">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg>
        <span class="btn-label">Filter</span>
        <span class="filter-dot" id="filter-dot" hidden></span>
      </button>
      <button type="button" id="btn-new-poi" class="btn btn-primary" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span class="btn-label">Neuer POI</span>
      </button>
    </div>
  </header>

  <main class="map-wrap">
    <div id="map" aria-label="Karte von <%= city.name %>"></div>

    <div id="pick-hint" class="pick-hint" role="status" hidden>
      Tippe auf die Karte, um den Ort für den neuen POI zu wählen.
    </div>

    <section id="filter-panel" class="popover" aria-labelledby="filter-title" hidden>
      <div class="popover-head">
        <h2 id="filter-title">Kategorien</h2>
        <div class="popover-tools">
          <button type="button" class="link-btn" data-filter="all">Alle</button>
          <button type="button" class="link-btn" data-filter="none">Keine</button>
        </div>
      </div>
      <ul id="filter-list" class="filter-list"></ul>
    </section>

    <aside id="poi-panel" class="panel" aria-labelledby="poi-panel-title" hidden>
      <form id="poi-form" novalidate>
        <div class="panel-head">
          <h2 id="poi-panel-title">Neuer POI</h2>
          <button type="button" class="icon-btn" data-action="close" aria-label="Schließen">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>

        <label class="field">
          <span>Titel <em>*</em></span>
          <input name="title" type="text" maxlength="120" required autocomplete="off"
                 placeholder="z. B. Lieblingscafé am Marktplatz">
        </label>

        <fieldset class="field" id="category-field">
          <legend>Kategorie <em>*</em></legend>
          <div class="category-grid" id="category-options"></div>
        </fieldset>

        <label class="field">
          <span>Beschreibung</span>
          <textarea name="description" rows="3" maxlength="2000"
                    placeholder="Was macht diesen Ort besonders?"></textarea>
        </label>

        <label class="field">
          <span>Adresse</span>
          <input name="address" type="text" maxlength="300" autocomplete="off">
          <small class="field-hint" id="address-hint"></small>
        </label>

        <label class="field">
          <span>Autor:in <em>*</em></span>
          <input name="author" type="text" maxlength="80" required autocomplete="nickname"
                 placeholder="Dein Name">
        </label>

        <p class="panel-note">Tipp: Ziehe den Marker oder tippe auf die Karte, um den Ort zu ändern.</p>
        <p class="form-error" id="form-error" role="alert" hidden></p>

        <div class="panel-actions">
          <button type="button" class="btn" data-action="close">Abbrechen</button>
          <button type="submit" class="btn btn-primary" id="btn-save">Speichern</button>
        </div>
      </form>
    </aside>

    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
  </main>

  <script>
    window.CITY = <%- JSON.stringify(city).replace(/</g, "\\u003c") %>;
  </script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script src="/app.js?v=<%= version %>"></script>
</body>
</html>
